# JWT_SECRET: Secret key for signing and verifying JWT authentication tokens.
# If missing at boot, an ephemeral random secret is generated and a warning is logged.
JWT_SECRET=

# PORT: The port the Express server listens on (default: 3000).
PORT=3000

# ALLOW_PHOTOS: Flag to toggle community photo uploads (true/false).
ALLOW_PHOTOS=true

# FDC_API_KEY: Optional FoodData Central API key for external nutritional lookups.
FDC_API_KEY=
